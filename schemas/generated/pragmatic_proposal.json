{
  "$defs": {
    "CostEstimate": {
      "additionalProperties": false,
      "description": "Structured breakdown of financial and engineering costs.",
      "properties": {
        "implementation_effort": {
          "$ref": "#/$defs/EffortLevel"
        },
        "infrastructure_cost_estimate": {
          "minLength": 1,
          "title": "Infrastructure Cost Estimate",
          "type": "string"
        },
        "additional_costs": {
          "items": {
            "type": "string"
          },
          "title": "Additional Costs",
          "type": "array"
        }
      },
      "required": [
        "implementation_effort",
        "infrastructure_cost_estimate"
      ],
      "title": "CostEstimate",
      "type": "object"
    },
    "EffortLevel": {
      "description": "Implementation effort estimation.",
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "VERY_HIGH"
      ],
      "title": "EffortLevel",
      "type": "string"
    },
    "ReversibilityAssessment": {
      "additionalProperties": false,
      "description": "Analysis of decision reversibility and rollback cost.",
      "properties": {
        "score": {
          "$ref": "#/$defs/ReversibilityLevel"
        },
        "rationale": {
          "minLength": 5,
          "title": "Rationale",
          "type": "string"
        },
        "rollback_strategy": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rollback Strategy"
        }
      },
      "required": [
        "score",
        "rationale"
      ],
      "title": "ReversibilityAssessment",
      "type": "object"
    },
    "ReversibilityLevel": {
      "description": "How easily the proposed decision can be reverted in the future.",
      "enum": [
        "HIGH",
        "MEDIUM",
        "LOW"
      ],
      "title": "ReversibilityLevel",
      "type": "string"
    },
    "Severity": {
      "description": "Severity classification for risks, vulnerabilities, and assumptions.",
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ],
      "title": "Severity",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Proposal formulated by the Pragmatist prioritizing KISS, YAGNI, and rapid time-to-value.",
  "properties": {
    "artifact_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Artifact Id",
      "type": "string"
    },
    "version": {
      "default": 1,
      "exclusiveMinimum": 0,
      "title": "Version",
      "type": "integer"
    },
    "supersedes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Supersedes"
    },
    "content_hash": {
      "anyOf": [
        {
          "description": "SHA-256 hash string optionally prefixed with sha256:",
          "pattern": "^(sha256:)?[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Content Hash"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "proponent_role": {
      "const": "PRAGMATIST",
      "default": "PRAGMATIST",
      "title": "Proponent Role",
      "type": "string"
    },
    "title": {
      "minLength": 3,
      "title": "Title",
      "type": "string"
    },
    "solution": {
      "description": "Comprehensive architectural/technical solution",
      "minLength": 10,
      "title": "Solution",
      "type": "string"
    },
    "rationale": {
      "description": "Why this solution best satisfies the problem",
      "minLength": 10,
      "title": "Rationale",
      "type": "string"
    },
    "benefits": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Benefits",
      "type": "array"
    },
    "costs": {
      "$ref": "#/$defs/CostEstimate"
    },
    "risks": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Risks",
      "type": "array"
    },
    "complexity": {
      "$ref": "#/$defs/Severity"
    },
    "reversibility": {
      "$ref": "#/$defs/ReversibilityAssessment"
    },
    "future_implications": {
      "minLength": 5,
      "title": "Future Implications",
      "type": "string"
    },
    "assumptions": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Assumptions",
      "type": "array"
    },
    "invalidation_conditions": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Invalidation Conditions",
      "type": "array"
    },
    "time_to_value": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Time To Value"
    },
    "simplifications_made": {
      "items": {
        "type": "string"
      },
      "title": "Simplifications Made",
      "type": "array"
    }
  },
  "required": [
    "artifact_id",
    "title",
    "solution",
    "rationale",
    "benefits",
    "costs",
    "risks",
    "complexity",
    "reversibility",
    "future_implications",
    "assumptions",
    "invalidation_conditions"
  ],
  "title": "PragmaticProposal",
  "type": "object"
}
